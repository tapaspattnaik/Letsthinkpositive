generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(255)
  name      String?  @db.VarChar(100)
  createdAt DateTime @default(now())
  active    Boolean  @default(true)

  @@map("subscribers")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  password  String?  @db.VarChar(255)
  googleId  String?  @unique @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  bio       String?  @db.VarChar(400)
  website   String?  @db.VarChar(500)
  interests String   @default("") @db.VarChar(500)
  avatarUrl  String?  @db.VarChar(500)
  coverStyle String?  @db.VarChar(100)
  coverUrl   String?  @db.VarChar(500)
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Personalisation profile — captured at registration / in profile edit.
  // Drives birthday automation, tailored recommendations, AI tone & timing.
  dateOfBirth DateTime? @map("date_of_birth")
  pronouns    String?   @db.VarChar(30)
  primaryGoal String?   @map("primary_goal") @db.VarChar(50)
  lifeStage   String?   @map("life_stage")   @db.VarChar(40)
  timezone    String?   @db.VarChar(64)

  // Access control
  role          String    @default("user") @db.VarChar(20)
  blocked       Boolean   @default(false)
  blockedReason String?   @map("blocked_reason")  @db.VarChar(500)
  blockedAt     DateTime? @map("blocked_at")
  lastLoginAt   DateTime? @map("last_login_at")

  // Personalisation
  favouriteTools String   @default("[]") @map("favourite_tools") @db.VarChar(500)

  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?
  streakFreezes  Int       @default(1) @map("streak_freezes") // tokens that auto-save a streak on a single missed day; earned via badges, capped at 3
  coins          Int       @default(0) // Hope Coins — earned via daily claims & activities, spent in the rewards store

  badges             UserBadge[]
  memories           UserMemory[]
  progress           ChallengeProgress[]
  posts              CommunityPost[]
  groupMemberships   GroupMember[]
  groupPosts         GroupPost[]
  postLikes          PostLike[]
  postComments       PostComment[]
  blogLikes          BlogLike[]
  blogComments       BlogComment[]
  blogSubmissions    UserBlogPost[]
  reports            PostReport[]
  notifications      Notification[]
  communityLikes     CommunityLike[]
  communityReactions CommunityReaction[]
  communityComments  CommunityComment[]
  following          Follow[]            @relation("UserFollowing")
  followers          Follow[]            @relation("UserFollowers")
  passwordResets     PasswordReset[]
  moodEntries        MoodEntry[]
  habits             Habit[]
  gratitudeEntries   GratitudeEntry[]
  intentions         DailyIntention[]
  kindnessActs       KindnessAct[]
  galleryPosts       GalleryPost[]
  galleryHearts      GalleryHeart[]
  sleepLogs          SleepLog[]
  assessments        WellnessAssessment[]
  savedQuotes        SavedQuote[]
  dailyRecipes       DailyRecipe[]
  weeklyInsights     WeeklyInsight[]
  coinTransactions   CoinTransaction[]
  sentMessages       DirectMessage[] @relation("SentMessages")
  receivedMessages   DirectMessage[] @relation("ReceivedMessages")
  presence           UserPresence?

  @@map("users")
}

// ── Hope Coins — transaction ledger ─────────────────────────────────────────
// Positive amounts = earned, negative = spent. User.coins holds the balance.

model CoinTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Int // +earn / -spend
  reason    String   @db.VarChar(100) // daily_claim | challenge_complete | badge_earned | redeem_freeze | redeem_badge | ...
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, reason, createdAt]) // fast "claimed today?" lookups
  @@map("coin_transactions")
}

model Badge {
  id          Int     @id @default(autoincrement())
  slug        String  @unique @db.VarChar(100)
  name        String  @db.VarChar(100)
  description String  @db.VarChar(300)
  icon        String  @db.VarChar(10)
  tier        String  @db.VarChar(20)
  challenge   String? @db.VarChar(100)

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       Int      @id @default(autoincrement())
  userId   Int
  badgeId  Int
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model ChallengeProgress {
  id            Int       @id @default(autoincrement())
  userId        Int
  challengeSlug String    @db.VarChar(100)
  completedDays String    @default("[]") @db.Text
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, challengeSlug])
  @@index([userId])                    // speeds up progress lookups per user
  @@index([challengeSlug, startedAt])  // speeds up stats query (slug + order)
  @@map("challenge_progress")
}

model CommunityPost {
  id           Int                 @id @default(autoincrement())
  title        String              @db.VarChar(200)
  body         String              @db.Text
  author       String              @default("Anonymous") @db.VarChar(100)
  tags         String              @default("") @db.VarChar(500)
  images       String              @default("[]") @db.Text // JSON array of image URLs
  postType     String              @default("story") @db.VarChar(20) // story | wish
  approved     Boolean             @default(false)
  featuredWeek String?             @db.VarChar(10) // YYYY-Www e.g. "2025-W21", null if not featured
  createdAt    DateTime            @default(now())
  userId       Int?
  user         User?               @relation(fields: [userId], references: [id])
  likes        CommunityLike[]
  reactions    CommunityReaction[]
  comments     CommunityComment[]

  @@index([approved, createdAt])   // speeds up the main feed query (WHERE approved=true ORDER BY createdAt)
  @@index([approved, postType])    // speeds up story vs wish filtering
  @@map("community_posts")
}

model CommunityLike {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@map("community_likes")
}

model CommunityComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  body      String   @db.VarChar(600)
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("community_comments")
}

model CommunityReaction {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  emoji     String   @db.VarChar(10) // 🙏 ❤️ 💪 ✨ 😊
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id])

  @@unique([postId, userId, emoji])
  @@map("community_reactions")
}

// ── Circles (closed groups) ───────────────────────────────────────────────

model Circle {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(100)
  description String   @db.Text
  icon        String   @default("🌿") @db.VarChar(10)
  color       String   @default("from-teal-deep to-teal-dark") @db.VarChar(50)
  isPrivate   Boolean  @default(true)
  createdAt   DateTime @default(now())

  members GroupMember[]
  posts   GroupPost[]

  @@map("circles")
}

model GroupMember {
  id       Int      @id @default(autoincrement())
  circleId Int
  userId   Int
  role     String   @default("member") @db.VarChar(20)
  joinedAt DateTime @default(now())

  circle Circle @relation(fields: [circleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([circleId, userId])
  @@map("group_members")
}

model GroupPost {
  id        Int      @id @default(autoincrement())
  circleId  Int
  userId    Int
  body      String   @db.Text
  tags      String   @default("") @db.VarChar(500)
  images    String   @default("[]") @db.Text // JSON array of image URLs
  createdAt DateTime @default(now())

  circle   Circle        @relation(fields: [circleId], references: [id])
  user     User          @relation(fields: [userId], references: [id])
  likes    PostLike[]
  comments PostComment[]

  @@map("group_posts")
}

model PostLike {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())

  post GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@map("post_likes")
}

model PostComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  body      String   @db.Text
  createdAt DateTime @default(now())

  post GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id])

  @@map("post_comments")
}

// ── Blog interactions ─────────────────────────────────────────────────────

model BlogLike {
  id        Int      @id @default(autoincrement())
  slug      String   @db.VarChar(200)
  userId    Int?
  ipHash    String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@unique([slug, userId])
  @@map("blog_likes")
}

model BlogComment {
  id        Int      @id @default(autoincrement())
  slug      String   @db.VarChar(200)
  userId    Int?
  author    String   @db.VarChar(100)
  body      String   @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("blog_comments")
}

model BlogView {
  id        Int      @id @default(autoincrement())
  slug      String   @db.VarChar(200)
  ipHash    String   @db.VarChar(64)   // hashed IP so views are unique per visitor
  createdAt DateTime @default(now())

  @@unique([slug, ipHash])  // one view per visitor per post
  @@index([slug])
  @@map("blog_views")
}

// ── Post reports ─────────────────────────────────────────────────────────

model PostReport {
  id               Int       @id @default(autoincrement())
  reporterId       Int
  reportedUserId   Int?      @map("reported_user_id")
  postType         String    @db.VarChar(30) // community | circle | user_blog
  postId           Int
  reason           String    @db.VarChar(100)
  details          String?   @db.Text
  status           String    @default("pending") @db.VarChar(20) // pending | resolved | dismissed
  adminNote        String?   @db.Text
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  reporter User @relation(fields: [reporterId], references: [id])

  @@map("post_reports")
}

// ── Notifications ────────────────────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   @db.VarChar(50) // like | comment | blog_approved | blog_rejected | report_resolved | circle_post
  message   String   @db.VarChar(500)
  link      String?  @db.VarChar(500)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ── User-submitted blog posts ─────────────────────────────────────────────

model UserBlogPost {
  id           Int      @id @default(autoincrement())
  userId       Int
  title        String   @db.VarChar(300)
  slug         String?  @unique @db.VarChar(320)
  excerpt      String?  @db.VarChar(500)
  body         String   @db.LongText
  category     String   @db.VarChar(100)
  subCategory  String?  @db.VarChar(100)
  images       String   @default("[]") @db.Text // JSON array of image URLs
  status       String   @default("pending") @db.VarChar(20) // pending | approved | rejected
  featuredWeek String?  @db.VarChar(10) // YYYY-Www e.g. "2025-W21", null if not featured
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("user_blog_posts")
}

// ── Follows ───────────────────────────────────────────────────────────────

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

// ── Mood tracker ─────────────────────────────────────────────────────────

model MoodEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  mood      Int // 1 = very low … 5 = great
  note      String?  @db.VarChar(300)
  date      String   @db.VarChar(10) // YYYY-MM-DD — one per user per day
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("mood_entries")
}

// ── Habit tracker ─────────────────────────────────────────────────────────

model Habit {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String   @db.VarChar(200)
  emoji     String   @default("✅") @db.VarChar(10)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@map("habits")
}

model HabitLog {
  id        Int      @id @default(autoincrement())
  habitId   Int
  userId    Int
  date      String   @db.VarChar(10) // YYYY-MM-DD
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@map("habit_logs")
}

// ── Gratitude Wall ────────────────────────────────────────────────────────

model GratitudeEntry {
  id        Int      @id @default(autoincrement())
  userId    Int?
  name      String   @default("Anonymous") @db.VarChar(100)
  content   String   @db.VarChar(280)
  hearts    Int      @default(0)
  date      String   @db.VarChar(10) // YYYY-MM-DD
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("gratitude_entries")
}

// ── Daily Intentions ─────────────────────────────────────────────────────

model DailyIntention {
  id         Int      @id @default(autoincrement())
  userId     Int?
  word       String   @db.VarChar(50)
  intention  String   @db.VarChar(200)
  kindness   String   @db.VarChar(200)
  reflection String?  @db.VarChar(300)
  date       String   @db.VarChar(10) // YYYY-MM-DD
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@map("daily_intentions")
}

// ── Kindness Map ──────────────────────────────────────────────────────────

model KindnessAct {
  id        Int      @id @default(autoincrement())
  userId    Int?
  act       String   @db.VarChar(200)
  city      String   @db.VarChar(100)
  country   String   @db.VarChar(100)
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("kindness_acts")
}

// ── Community Gallery ─────────────────────────────────────────────────────

model GalleryPost {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String   @db.VarChar(200)
  description String?  @db.Text
  imageUrl    String   @db.VarChar(500)
  category    String   @default("activity") @db.VarChar(50)
  approved    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  hearts GalleryHeart[]

  @@map("gallery_posts")
}

model GalleryHeart {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())

  post GalleryPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("gallery_hearts")
}

// ── Sleep Tracker ─────────────────────────────────────────────────────────

model SleepLog {
  id           Int      @id @default(autoincrement())
  userId       Int
  date         String   @db.VarChar(10)   // YYYY-MM-DD
  bedtime      String   @db.VarChar(5)    // HH:MM (24h)
  wakeTime     String   @db.VarChar(5)    // HH:MM (24h)
  durationMins Int                         // calculated duration
  quality      Int                         // 1–5
  notes        String?  @db.VarChar(500)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("sleep_logs")
}

// ── Saved Quotes ──────────────────────────────────────────────────────────

model SavedQuote {
  id          Int      @id @default(autoincrement())
  userId      Int
  text        String   @db.VarChar(500)
  attribution String?  @db.VarChar(200)
  source      String?  @db.VarChar(100)  // 'feed' | 'quotes' | 'user'
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, text(length: 100)])  // prevent saving same quote twice
  @@map("saved_quotes")
}

// ── Wellness Assessments (psychometric tests) ────────────────────────────

model WellnessAssessment {
  id        Int      @id @default(autoincrement())
  userId    Int
  testKey   String   @db.VarChar(30)   // phq9 | gad7 | pss10 | compassion | resilience | perma
  score     Int
  band      String   @db.VarChar(30)   // minimal | mild | moderate | severe | high | low etc.
  answers   String   @db.Text          // JSON array of answer indices
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, testKey])
  @@index([userId, createdAt])
  @@map("wellness_assessments")
}

// ── Password resets ───────────────────────────────────────────────────────

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique @db.VarChar(128)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ── AI Memory — coach/advisor remembers key facts about the user ──────────

model UserMemory {
  id        Int      @id @default(autoincrement())
  userId    Int
  key       String   @db.VarChar(100)  // e.g. "main_goal", "struggle", "name_pref"
  value     String   @db.Text
  source    String   @default("coach") @db.VarChar(30) // coach | advisor | manual
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_memories")
}

// ── Daily Wellness Recipe ─────────────────────────────────────────────────

model DailyRecipe {
  id          Int      @id @default(autoincrement())
  userId      Int
  date        String   @db.VarChar(10)   // YYYY-MM-DD
  tools       String   @db.VarChar(500)  // JSON array of tool slugs
  reasons     String   @db.Text          // JSON array of reason strings
  moodScore   Float?
  sleepHours  Float?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_recipes")
}

// ── Launch signups ────────────────────────────────────────────────────────
// Pre-launch landing-page leads. Created outside this app — declared here
// (mirroring the live table exactly) so `prisma db push` preserves it.

model LaunchSignup {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  email       String   @unique(map: "uq_launch_signups_email") @db.VarChar(255)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  countryCode String?  @map("country_code") @db.Char(2)
  countryName String?  @map("country_name") @db.VarChar(100)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  source      String   @default("landing_page") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([createdAt], map: "idx_launch_signups_created_at")
  @@index([countryCode], map: "idx_launch_signups_country_code")
  @@map("launch_signups")
}

// ── AI Weekly Insight ─────────────────────────────────────────────────────
// Cached once per ISO week per user — regenerated on next week start.

model WeeklyInsight {
  id          Int      @id @default(autoincrement())
  userId      Int
  week        String   @db.VarChar(10)   // ISO week: YYYY-Www  e.g. "2025-W22"
  insight     String   @db.VarChar(600)  // AI-generated insight text
  moodAvg     Float?                     // snapshot data used to generate
  sleepAvg    Float?
  streakDays  Int?
  habitRate   Float?                     // 0-1 completion rate
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, week])
  @@map("weekly_insights")
}

// ── Direct Messaging ─────────────────────────────────────────────────────────

model DirectMessage {
  id         Int       @id @default(autoincrement())
  senderId   Int
  receiverId Int
  body       String    @db.Text
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  sender   User @relation("SentMessages",     fields: [senderId],   references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, readAt])
  @@map("direct_messages")
}

// ── User Presence ─────────────────────────────────────────────────────────────
// lastSeenAt updated via /api/presence ping every ~90 s.
// Online = last seen within 5 minutes.

model UserPresence {
  userId     Int      @id
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_presence")
}

