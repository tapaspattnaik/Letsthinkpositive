{
  "name": "letsthinkpositive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/db-push.mjs",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate && node scripts/apply-patches.mjs",
    "start": "node server.js",
    "lint": "next lint",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "android:build": "cd android && gradlew assembleDebug && echo 'APK: android/app/build/outputs/apk/debug/app-debug.apk'"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@prisma/client": "^5.22.0",
    "@tiptap/extension-placeholder": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "groq-sdk": "^1.2.1",
    "html2canvas": "^1.4.1",
    "mammoth": "^1.12.0",
    "next": "^16.2.7",
    "next-auth": "^4.24.14",
    "nodemailer": "^9.0.1",
    "pdf-parse": "^2.4.5",
    "postcss": ">=8.5.10",
    "prisma": "^5.22.0",
    "prop-types": "^15.8.1",
    "react": "^18",
    "react-dom": "^18",
    "react-simple-maps": "^3.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
