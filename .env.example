# Together AI — get your key at api.together.ai
TOGETHER_API_KEY=your_together_api_key_here

# Google Analytics 4 — Measurement ID from analytics.google.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Database — MySQL on Hostinger (hPanel → Databases → MySQL Databases)
# Format: mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=mysql://db_user:db_password@localhost:3306/db_name

# Email — Hostinger SMTP settings
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@letsthinkpositive.com
SMTP_PASS=your_email_password_here
CONTACT_TO=hello@letsthinkpositive.com

# App
NEXT_PUBLIC_SITE_URL=https://letsthinkpositive.com
NODE_ENV=production

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here
NEXTAUTH_URL=https://letsthinkpositive.com

# Google OAuth — create at console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: https://letsthinkpositive.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# NewsAPI — get a free key at newsapi.org (100 req/day on free plan)
NEWS_API_KEY=your_newsapi_key_here

# Admin — the email address that has access to /admin
ADMIN_EMAIL=hello@letsthinkpositive.com
# Also expose for client-side admin check (optional):
NEXT_PUBLIC_ADMIN_EMAIL=hello@letsthinkpositive.com

# Meta / Facebook Graph API — for Contact page social feed
# Get from developers.facebook.com → Your App → Page Access Token
# FB_PAGE_ID: your Facebook Page numeric ID
# FB_PAGE_ACCESS_TOKEN: long-lived Page Access Token
# IG_USER_ID: Instagram Business Account User ID (linked to your FB Page)
FB_PAGE_ID=your_fb_page_id
FB_PAGE_ACCESS_TOKEN=your_fb_page_access_token
IG_USER_ID=your_instagram_user_id
